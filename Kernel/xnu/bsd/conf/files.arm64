# pthread.kext cannot be loaded on arm64 until a prelink/loading path exists.
# Build its implementation into the kernel; bsd_init registers its shim table.
../Extensions/pthread/kern_init.c	standard
../Extensions/pthread/kern_support.c	standard
bsd/pthread/pthread_kext_synch.c	standard

# hfs.kext cannot be loaded on arm64 until a prelink/loading path exists.
# Build it in and register it immediately after the kernel VFS table is ready.
../Extensions/hfs/core/hfs_resize.c	standard
../Extensions/hfs/core/hfs_vnops.c	standard
../Extensions/hfs/core/hfs_btreeio.c	standard
../Extensions/hfs/core/BTreeNodeOps.c	standard
../Extensions/hfs/core/BTree.c	standard
../Extensions/hfs/core/rangelist.c	standard
../Extensions/hfs/core/hfs_journal.c	standard
../Extensions/hfs/core/hfs_fsinfo.c	standard
../Extensions/hfs/core/hfs_chash.c	standard
../Extensions/hfs/core/hfs_xattr.c	standard
../Extensions/hfs/core/FileIDsServices.c	standard
../Extensions/hfs/core/hfs_extents.c	standard
../Extensions/hfs/core/hfs_endian.c	standard
../Extensions/hfs/core/hfs_cprotect.c	standard
../Extensions/hfs/core/hfs_readwrite.c	standard
../Extensions/hfs/core/CatalogUtilities.c	standard
../Extensions/hfs/core/BTreeWrapper.c	standard
../Extensions/hfs/core/hfs_catalog.c	standard
../Extensions/hfs/core/hfs_hotfiles.c	standard
