bsd/dev/arm64/conf.c		standard
bsd/dev/arm/cons.c		standard
bsd/dev/arm/km.c		standard
bsd/dev/arm/kern_machdep.c	standard
bsd/dev/arm/stubs.c		standard
bsd/dev/arm/systemcalls.c       standard
bsd/dev/arm64/sysctl.c          standard
bsd/dev/arm/unix_signal.c	standard

bsd/dev/arm64/cpu_in_cksum.s	standard

#if defined(KERNEL_INTEGRITY_CTRR)
bsd/tests/ctrr_test_sysctl.c		optional config_xnupost
#endif /* defined(KERNEL_INTEGRITY_CTRR) */

bsd/dev/arm64/dtrace_isa.c	optional config_dtrace
bsd/dev/arm64/dtrace_subr_arm.c	optional config_dtrace
bsd/dev/arm64/fbt_arm.c		optional config_dtrace
bsd/dev/arm64/fasttrap_isa.c	optional config_dtrace
bsd/dev/arm64/disassembler.c	optional config_dtrace
bsd/dev/arm64/sdt_arm.c		optional config_dtrace

bsd/dev/pgtrace/pgtrace_dev.c   optional config_pgtrace_nonkext

bsd/kern/bsd_stubs.c		standard

# pthread.kext cannot be loaded on arm64 until a prelink/loading path exists.
# Build its implementation into the kernel; bsd_init registers its shim table.
../Extensions/pthread/kern_init.c	standard
../Extensions/pthread/kern_support.c	standard
bsd/pthread/pthread_kext_synch.c	standard

# corecrypto.kext cannot be loaded on arm64 until a prelink/loading path exists.
# The kernel already supplies cc_clear and cc_cmp_safe, so do not compile the
# duplicate copies from the kext.
../Extensions/corecrypto/cc_debug.c	standard
../Extensions/corecrypto/cc_digest.c	standard
../Extensions/corecrypto/kext/cc_functions.c	standard
../Extensions/corecrypto/kext/cc_kext_main.c	standard
../Extensions/corecrypto/algorithms/cckprng.c	standard
../Extensions/corecrypto/algorithms/aes_ecb.c	standard
bsd/crypto/corecrypto_sha512_builtin.cpp	standard
../Extensions/corecrypto/algorithms/md5_impl.cpp	standard
../Extensions/corecrypto/algorithms/yarrow/comp.c	standard
../Extensions/corecrypto/algorithms/yarrow/smf.c	standard
../Extensions/corecrypto/algorithms/sha1.c	standard
../Extensions/corecrypto/algorithms/yarrow/sha1mod.c	standard
../Extensions/corecrypto/algorithms/yarrow/prng.c	standard
../Extensions/corecrypto/algorithms/aes128.c	standard
../Extensions/corecrypto/algorithms/aes_cbc.c	standard
../Extensions/corecrypto/algorithms/md5.c	standard
../Extensions/corecrypto/algorithms/yarrow/yarrowUtils.c	standard
../Extensions/corecrypto/algorithms/pdcrypto_digest_final.c	standard
bsd/crypto/corecrypto_sha1_builtin.cpp	standard
../Extensions/corecrypto/algorithms/pdcrypto_dummy.c	standard
